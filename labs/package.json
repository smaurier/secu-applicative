{
  "name": "securite-applicative-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Oracles exécutables des labs Sécurité applicative (règle : un lab = un geste métier complet). Les propriétés de sécurité sont prouvées par des attaques réelles simulées, pas affirmées.",
  "type": "module",
  "scripts": {
    "lab:01": "vitest run --root lab-01-oidc-pkce-webauthn-de-zero",
