    "lab:02": "vitest run --root lab-02-audit-owasp",
    "solution:02": "vitest run --root lab-02-audit-owasp --config vitest.solution.config.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
